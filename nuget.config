<?xml version="1.0" encoding="utf-8"?>
<!--
  Local NuGet sources for projects under this folder.

  LibSVMsharp 3.37.0 is not published on nuget.org (the latest public release is
  1.2.5), so it must be restored from the locally packed .nupkg. Rebuild it with:

      dotnet pack LibSVMsharp/LibSVMsharp.csproj -c Release -o LibSVMsharp/nupkg

  Note: a nuget.config only applies to projects in this directory tree. If the
  consuming project lives elsewhere, copy this file next to that project, or
  register the feed machine-wide once:

      dotnet nuget add source "<repo>\LibSVMsharp\nupkg" -n libsvmsharp-local
-->
<configuration>
  <packageSources>
    <!-- Relative paths are resolved against this file's directory. -->
    <add key="libsvmsharp-local" value="LibSVMsharp/nupkg" />
  </packageSources>
</configuration>
